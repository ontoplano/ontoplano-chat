{
	"name": "ontoplano-chat",
	"version": "0.1.8",
	"private": true,
	"description": "A local voice assistant that acts on ontoplano: a phone talks, a model on your own computer listens, answers and does.",
	"type": "module",
	"bin": {
		"ontoplano-chat": "bin/ontoplano-chat.mjs"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsx watch src/cli.ts serve",
		"start": "node bin/ontoplano-chat.mjs serve",
		"test": "vitest run && playwright test",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint . && tsc --noEmit -p tsconfig.json",
		"format": "prettier --write .",
		"icons": "node scripts/make-icons.mjs"
	},
	"dependencies": {
		"smol-toml": "^1.3.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.58.2",
		"@types/node": "^22",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.8.1",
		"tsx": "^4.20.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22"
	}
}
