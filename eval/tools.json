	{
		"name": "tasks",
		"description": "List and find todos including IDs.",
		"writes": false,
		"destroys": false,
		"inputSchema": {
			"type": "object",
			"properties": {
				"archived": { "type": "string", "enum": ["exclude", "include", "only"] },
				"completedSince": { "type": "string" },
				"createdSince": { "type": "string" },
				"direction": { "type": "string", "enum": ["asc", "desc"] },
				"fields": { "type": "string" },
				"ids": { "type": "array", "items": { "type": "integer" } },
				"includeArchived": { "type": "boolean" },
				"limit": { "type": "integer", "default": 50 },
				"maxEase": { "type": "number", "minimum": 0, "maximum": 5 },
				"maxInterest": { "type": "number", "minimum": 0, "maximum": 5 },
				"maxUrgency": { "type": "number", "minimum": 0, "maximum": 5 },
				"minEase": { "type": "number", "minimum": 0, "maximum": 5 },
				"minInterest": { "type": "number", "minimum": 0, "maximum": 5 },
				"minUrgency": { "type": "number", "minimum": 0, "maximum": 5 },
				"notebookId": { "type": "integer" },
				"offset": { "type": "integer", "default": 0 },
				"query": { "type": "string" },
				"scheduled": { "type": "string", "enum": ["any", "dated", "undated"] },
				"scheduledFrom": { "type": "string" },
				"scheduledTo": { "type": "string" },
				"sort": {
					"type": "string",
					"enum": ["completed", "created", "manual", "priority", "scheduled", "title", "updated"]
				},
				"status": { "type": "string", "enum": ["closed", "doing", "done", "open", "skipped", "todo"] },
				"taggedSince": { "type": "string" },
				"tagMode": { "type": "string", "enum": ["all", "any"] },
				"tags": { "type": "array", "items": { "type": "string" } },
				"updatedSince": { "type": "string" },
				"verbose": { "type": "boolean" },
				"withoutTags": { "type": "array", "items": { "type": "string" } }
			}
		}
	},
